# Ne pas remplacer la SECRET_KEY existante lors de la mise à jour de .env.
SECRET_KEY=remplacer-par-une-cle-aleatoire
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# PostgreSQL : Compose initialise une base séparée dans un volume Docker.
POSTGRES_DB=dublao
POSTGRES_USER=dublao
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432 
WEB_PORT=8000


# R2 : bucket privé, accès public désactivé.
# Utiliser les identifiants S3 d'un jeton limité à ce bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=



MURFDUB_API_KEY=
GOOGLE_OAUTH_CLIENT_ID=''
GOOGLE_OAUTH_CLIENT_SECRET=''
EMAIL_DELIVERY='console'
EMAIL_HOST=''
EMAIL_PORT='587'
EMAIL_USE_TLS='true'
EMAIL_USE_SSL='false'
EMAIL_HOST_USER=''
EMAIL_HOST_PASSWORD=''
DEFAULT_FROM_EMAIL=''

# Studio de doublage (clé Murf Dub, distincte de TTS)
MURFDUB_ENABLED=true
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
STUDIO_MAX_UPLOAD_BYTES=0
STUDIO_MAX_ACTIVE_JOBS=3
DOCKER_POSTGRES_HOST=host.docker.internal

# Portefeuille : packs ponctuels en USD, minute entamée par langue.
CREDITS_ENABLED=true
GENIUSPAY_API_KEY=
GENIUSPAY_API_SECRET=
GENIUSPAY_WEBHOOK_SECRET=
GENIUSPAY_WEBHOOK_SECRET_LIVE=
GENIUSPAY_WEBHOOK_SECRET_SANDBOX=
GENIUSPAY_ENVIRONMENT=sandbox
# Adresse du site utilisée pour le retour du checkout. HTTPS en production.
PAYMENT_PUBLIC_URL=http://127.0.0.1:8000
FFPROBE_BINARY=ffprobe

# Référencement : activer uniquement avec le domaine HTTPS définitif et DEBUG=false.
SITE_PUBLIC_URL=
SEO_INDEXING_ENABLED=false
